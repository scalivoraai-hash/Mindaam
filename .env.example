# LOCAL ONLY. Copy to .env; never commit credentials.
APP_ENV=local
DATABASE_URL=sqlite:///./pulseworld-local.db
POSTGRES_PASSWORD=replace-with-long-local-password
REDIS_URL=
PUBLIC_ORIGIN=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:8000
# Optional external providers. Blank credentials must fail closed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
PULSEPOINT_SECRET=

STRIPE_SUBSCRIPTION_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
MAIL_ENCRYPTION_KEY=
# Preview/staging origin must match the browser origin exactly for realtime.

# Virtual-world conversation eligibility; no device GPS.
TALK_INTERACTION_METRES=10
TALK_WARNING_METRES=18
TALK_DISCONNECT_METRES=25
TALK_DISCONNECT_GRACE_SECONDS=8
TALK_MAX_PARTICIPANTS=6
# originals = either original participant; host = creator only
TALK_JOIN_APPROVAL=originals
TALK_REJOIN_COOLDOWN_SECONDS=120

# World-access growth: access only; independent from referral and reward ledgers
WORLD_SHARE_COOLDOWN_SECONDS=5
WORLD_HOT_ONLINE=20
WORLD_ACTIVE_ONLINE=3

# Initial owner only. Supply all three through deployment secrets, never commit values.
# Bootstrap creates one owner, refuses to elevate an existing account and requires a password change.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_INITIAL_PASSWORD=
# Seconds of sustained blocked virtual movement before rate-limited diagnostics.
WORLD_STALL_SECONDS=2.5
